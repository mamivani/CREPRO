# Reference copies and local state: never part of a build context.
sample_code/
vendor/
.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
.env.*

# Docs and non-runtime assets don't need to be in any service image.
docs/
infra/

# apps/web (Next.js) build artifacts and deps: never part of any build
# context. Dependencies are reinstalled with npm ci inside the Dockerfile.
**/node_modules/
**/.next/
apps/web/playwright-report/
apps/web/test-results/
